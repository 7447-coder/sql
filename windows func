WINDOW FUNCTIONS
ROW_NUMBER
Q61. Give row numbers to employees according to salary.
SELECT
    employee_name,
    salary,
    ROW_NUMBER() OVER (
        ORDER BY salary DESC
    ) AS row_num
FROM employees;
Q62. Find the highest-paid employee using ROW_NUMBER.
WITH ranked_employees AS (
    SELECT
        employee_name,
        salary,
        ROW_NUMBER() OVER (
            ORDER BY salary DESC
        ) AS rn
    FROM employees
)
SELECT *
FROM ranked_employees
WHERE rn = 1;
Q63. Find the top 3 highest-paid employees.
WITH ranked_employees AS (
    SELECT
        employee_name,
        salary,
        ROW_NUMBER() OVER (
            ORDER BY salary DESC
        ) AS rn
    FROM employees
)
SELECT *
FROM ranked_employees
WHERE rn <= 3;
15. RANK
Q64. Rank employees according to salary.
SELECT
    employee_name,
    salary,
    RANK() OVER (
        ORDER BY salary DESC
    ) AS salary_rank
FROM employees;
Q65. Rank products according to price within each category.
SELECT
    product_name,
    category,
    price,
    RANK() OVER (
        PARTITION BY category
        ORDER BY price DESC
    ) AS category_rank
FROM products;
16. Top N Per Group
Q66. Find the highest-paid employee from each department.
WITH ranked_employees AS (
    SELECT
        employee_name,
        department,
        salary,
        ROW_NUMBER() OVER (
            PARTITION BY department
            ORDER BY salary DESC
        ) AS rn
    FROM employees
)
SELECT *
FROM ranked_employees
WHERE rn = 1;
