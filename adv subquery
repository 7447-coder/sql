Advanced Subqueries
Q58. Find customers whose total spending is greater than ₹50,000.
SELECT
    c.customer_id,
    c.customer_name
FROM customers c
JOIN orders o
    ON c.customer_id = o.customer_id
GROUP BY c.customer_id, c.customer_name
HAVING SUM(o.total_amount) > 50000;
Q59. Find the customer who spent the most.
SELECT TOP 1
    c.customer_name,
    SUM(o.total_amount) AS total_spent
FROM customers c
JOIN orders o
    ON c.customer_id = o.customer_id
GROUP BY c.customer_id, c.customer_name
ORDER BY total_spent DESC;
Q60. Find the most expensive product in each category.
SELECT *
FROM products p
WHERE price = (
    SELECT MAX(p2.price)
    FROM products p2
    WHERE p2.category = p.category
);
